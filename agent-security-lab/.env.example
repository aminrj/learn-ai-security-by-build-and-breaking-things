# ---- Agent Security Lab configuration ----
# Copy to .env and edit. .env is gitignored; this example is committed.

# Which model backend the agent uses: llamacpp | anthropic | openai | scripted
# - llamacpp  : default, OpenAI-compatible llama.cpp server (real model, e.g. Qwen on a 3090)
# - anthropic : Anthropic Messages API (real)
# - openai    : OpenAI Chat Completions API (real)
# - scripted  : deterministic test double (used by the attack suite ONLY; never "real")
ASL_BACKEND=llamacpp

# Hard cap on agent loop turns (untrusted output can otherwise loop forever).
ASL_MAX_TURNS=8

# ---- llama.cpp (OpenAI-compatible server) ----
ASL_LLAMACPP_BASE_URL=http://localhost:8080/v1
ASL_LLAMACPP_MODEL=qwen2.5-7b-instruct
ASL_LLAMACPP_API_KEY=sk-no-key-required

# ---- Anthropic ----
ANTHROPIC_API_KEY=
ASL_ANTHROPIC_MODEL=claude-opus-4-8

# ---- OpenAI ----
OPENAI_API_KEY=
ASL_OPENAI_MODEL=gpt-4o

# ---- Target / lab wiring ----
# Directory the agent's read_file/run_shell operate over (the prize lives here).
ASL_WORKDIR=./target/workdir
# Local web server serving target/docs (indirect-injection vectors).
ASL_DOCS_URL=http://localhost:8081
# The honeypot "forbidden host" — any request here is logged as exfil/SSRF evidence.
ASL_HONEYPOT_URL=http://localhost:9009
ASL_HONEYPOT_LOG=./target/honeypot/honeypot.log

# ---- Defenses (Phase 5) — inert until enabled ----
ASL_DEFENSES_ENABLED=false
