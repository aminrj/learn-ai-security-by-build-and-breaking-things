# lab secrets that are the attack prize). Real secrets live in .env, which is not.
.env
.env.local
*.local.env

# ---- Lab run artifacts ----
# Attack/defense run outputs are regenerated; keep the dirs (.gitkeep) not the runs.
attacks/results/*/
reports/out/
honeypot.log
*.jsonl
!attacks/fixtures/*.jsonl

